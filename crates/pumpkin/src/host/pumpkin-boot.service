[Unit]
Description=Remove what lost Pumpkin runs left
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=@USER@
# As each build's boot made its files before, which its user alone reads.
UMask=0077
ExecStart=@PUMPKIN@ controller boot-all

[Install]
WantedBy=multi-user.target
